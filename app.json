{
  "expo": {
    "name": "AntiLate",
    "slug": "AntiLate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/antilate-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.antilate.app",
      "versionCode": 3,
      "permissions": [
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_FULL_SCREEN_INTENT",
        "VIBRATE",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_SPECIAL_USE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFDFC",
        "foregroundImage": "./assets/antilate-adaptive-foreground.png",
        "monochromeImage": "./assets/antilate-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/antilate-favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-dev-client",
      "./plugins/with-antilate-alarm",
      "expo-system-ui"
    ],
    "extra": {
      "eas": {
        "projectId": "49360fda-9a1f-4a10-a0f6-22887cfdb732"
      }
    }
  }
}
